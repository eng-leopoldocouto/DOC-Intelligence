{
  "name": "doc-intelligence-atendimento",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interface do atendimento do DOC Intelligence — Trilha B",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "contagens": "node scripts/conferir-contagens.mjs",
    "gen:api": "openapi-typescript docs/spec/openapi.yaml -o src/shared/api/types.gen.ts",
    "mock": "tsx src/mocks/servidor.ts",
    "fixtures": "python scripts/gerar-documentos-ficticios.py",
    "carta:pdf": "python scripts/gerar-carta-pdf.py"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@mswjs/http-middleware": "^0.10.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^5.0.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^5.2.1",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.4.4",
    "oxlint": "^1.80.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
