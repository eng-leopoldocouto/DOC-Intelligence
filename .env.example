# Modo da API: "mock" usa os handlers MSW; "live" aponta para a API real
VITE_API_MODE=mock
VITE_API_BASE=/api/v1

# Identidade injetada pelo host interno (ADR-011).
# Em produção NÃO se define aqui: o sistema hospedeiro envia por cabeçalho.
# Deixe em branco para exercitar a degradação anônima do fato (g).
VITE_USUARIO_ID=ana.souza
VITE_USUARIO_NOME=Ana Souza
